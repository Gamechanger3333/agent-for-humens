# --- API security ---
# Shared secret the Next.js proxy sends as X-API-Key. Must match
# AGENT_API_KEY in the root .env.local. Leave unset only for quick local
# testing — the server will warn loudly and run with no auth.
#   openssl rand -hex 32
AGENT_API_KEY=change-me-to-a-random-secret

# Comma-separated list of origins allowed to call this API directly
# (browser -> FastAPI, bypassing the Next.js proxy). Empty/unset = closed.
# The Next.js proxy itself doesn't need this — server-to-server requests
# aren't subject to CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Requests allowed per client IP per minute before a 429 is returned.
RATE_LIMIT_PER_MINUTE=20

# --- Model provider switch ---
# "bedrock" (default) or "groq". Flip this back to bedrock once AWS access is restored.
MODEL_PROVIDER=groq

# --- AWS / Bedrock (used when MODEL_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional if using temporary creds / SSO
# AWS_SESSION_TOKEN=

# Bedrock model id (Claude 3.5 Sonnet inference profile, or a Nova model)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Groq (used when MODEL_PROVIDER=groq) ---
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_ID=openai/gpt-oss-120b

# --- Supabase (used by check_followups in step 2) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
