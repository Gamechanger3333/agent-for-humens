# Server-only. Read by app/api/**/route.ts and middleware.ts — never by
# browser code (no NEXT_PUBLIC_ prefix, so Next.js will not ship these to
# the client bundle).

# Where the FastAPI agent backend is running.
AGENT_API_URL=http://localhost:8787

# Shared secret sent as X-API-Key to the FastAPI backend. Must match
# AGENT_API_KEY in agent/.env. Generate one with:
#   openssl rand -hex 32
AGENT_API_KEY=change-me-to-a-random-secret

# Password gate for the whole dashboard (protects a public deploy URL from
# being used by strangers). Leave unset to disable — useful for local dev.
DASHBOARD_PASSWORD=change-me
